    {
        "id": "7a5e126dc3ac5042",
        "type": "function",
        "z": "f6f2187d.f17ca8",
        "name": "function 2",
        "func": "msg.topic = \"readmultiple\";\n\nmsg.payload = [\"ns=4;i=58\",\n               \"ns=4;i=59\",\n               \"ns=4;i=61\",\n               \"ns=4;i=62\",\n               \"ns=4;i=63\",\n               \"ns=4;i=64\", \n               \"ns=4;i=79\",\n               \"ns=4;i=90\",\n               \"ns=4;i=101\", \n               \"ns=4;i=112\",\n               \"ns=4;i=123\",\n                \"ns=4;i=134\",\n                \"ns=4;i=145\",];  \n \n\nreturn msg;",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
