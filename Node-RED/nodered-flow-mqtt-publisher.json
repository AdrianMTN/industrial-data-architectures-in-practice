    {
        "id": "44164888443b497e",
        "type": "function",
        "z": "f6f2187d.f17ca8",
        "name": "function 3",
        "func": "// 1. Verificăm dacă payload-ul este un array valid\nif (msg.payload && Array.isArray(msg.payload)) {\n    let arrayBrut = [];\n\n    // 2. Iterăm prin cele 11 obiecte primite de la OPC UA și extragem doar valoarea numerică\n    for (let i = 0; i < msg.payload.length; i++) {\n        let element = msg.payload[i];\n        let valoare = null;\n\n        if (element !== undefined && element !== null) {\n            // Extrage .value.value dacă structura este dublu-imbricată, altfel .value\n            if (element.value && element.value.value !== undefined) {\n                valoare = element.value.value;\n            } else if (element.value !== undefined) {\n                valoare = element.value;\n            } else {\n                valoare = element;\n            }\n        }\n        arrayBrut.push(valoare);\n    }\n\n    // 3. Adăugăm timestamp-ul curent generat de sistem ca ultimul element (indexul 11)\n    let dataConstruita = new Date().toISOString();\n    arrayBrut.push(dataConstruita);\n\n    // 4. Pregătim string-ul JSON curat pentru MQTT (fără array-uri imbricate)\n    msg.payload = JSON.stringify(arrayBrut);\n    \n    // Deoarece nodul OPC UA trimite deja tot pachetul deodată, nu mai avem nevoie de stocare în context\n    return msg;\n}\n\n// Dacă mesajul nu este un array valid, îl ignorăm\nreturn null;\n",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 860,
        "y": 320,
        "wires": [
            [
                "7c3b12968551d9a3",
                "283b3d5495ce87d7"
            ]
        ]
    },
